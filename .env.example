# Postgres
POSTGRES_USER=homeworke
POSTGRES_PASSWORD=change_me
POSTGRES_DB=homeworke
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgres://homeworke:change_me@postgres:5432/homeworke
PORT=4000
NODE_ENV=production
# Signs login tokens — MUST be a long random string, and MUST stay the same
# across restarts/deploys or every logged-in user gets kicked out.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
# Skip the daily 03:00 Europe/Moscow sync job (useful in local dev)
DISABLE_SYNC_CRON=false

# Frontend (build-time; baked into the static bundle by Vite)
# In prod the frontend nginx proxies /api to the backend service, so this is
# normally left empty (same-origin requests). Set it only for a split deploy.
VITE_API_URL=
